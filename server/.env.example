# Servidor do Novelo — copie pra .env (ou rode: npm run setup, que gera os segredos).
# Nada daqui vai pro git. Permissão do arquivo: 600.

# Onde ouvir. Atrás de um proxy HTTPS (Caddy, nginx, Cloudflare Tunnel), deixe TRUST_PROXY=1.
PORT=8787
HOST=0.0.0.0
TRUST_PROXY=1
# O banco (SQLite). Faça backup deste arquivo (veja DEPLOY.md).
DB_PATH=./data/novelo.db

# Segredos gerados (npm run setup). TOKEN_SECRET assina os passes do app: trocar = todo mundo pega
# um passe novo sozinho. ADMIN_KEY + ADMIN_TOTP_SECRET entram no painel (/admin).
TOKEN_SECRET=
ADMIN_KEY=
ADMIN_TOTP_SECRET=

# OpenRouter. FREE: uma chave SEM crédito (limite 0), só modelos grátis — o teste de 7 dias.
# PAID: uma chave COM limite de gasto (ex.: US$ 20/mês) — Novelo+, testadores e dono.
OPENROUTER_FREE_KEY=
OPENROUTER_PAID_KEY=

# Google Play (quando o app estiver na loja): o pacote, a conta de serviço com acesso ao Play
# Console (o JSON inteiro numa linha, ou o caminho do arquivo) e a chave dos avisos (RTDN, Pub/Sub).
PLAY_PACKAGE=com.villamediana.novelo
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
RTDN_KEY=
