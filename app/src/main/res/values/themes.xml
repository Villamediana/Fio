<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Novelo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Novelo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_vermilion</item>
        <item name="postSplashScreenTheme">@style/Theme.Novelo</item>
    </style>

    <!-- The splash in the accent she chose (Android 13+ keeps it for the next openings: LauncherIcon). -->
    <style name="Theme.Novelo.Splash.Blue">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_blue</item>
    </style>
    <style name="Theme.Novelo.Splash.Green">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_green</item>
    </style>
    <style name="Theme.Novelo.Splash.Pink">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_pink</item>
    </style>
    <style name="Theme.Novelo.Splash.Purple">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_purple</item>
    </style>
    <style name="Theme.Novelo.Splash.Teal">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_teal</item>
    </style>
    <style name="Theme.Novelo.Splash.Graphite">
        <item name="windowSplashScreenAnimatedIcon">@drawable/novelo_splash_graphite</item>
    </style>
</resources>
