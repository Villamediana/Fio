<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The gesture's entry: nothing on screen, no animation. -->
    <style name="Theme.Fio.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.Fio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_vermilion</item>
        <item name="postSplashScreenTheme">@style/Theme.Fio</item>
    </style>

    <!-- The splash in the accent she chose (Android 13+ keeps it for the next openings: LauncherIcon). -->
    <style name="Theme.Fio.Splash.Blue">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_blue</item>
    </style>
    <style name="Theme.Fio.Splash.Green">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_green</item>
    </style>
    <style name="Theme.Fio.Splash.Pink">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_pink</item>
    </style>
    <style name="Theme.Fio.Splash.Purple">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_purple</item>
    </style>
    <style name="Theme.Fio.Splash.Teal">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_teal</item>
    </style>
    <style name="Theme.Fio.Splash.Graphite">
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash_graphite</item>
    </style>
</resources>
