<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fio_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Fio</item>
    </style>
</resources>
