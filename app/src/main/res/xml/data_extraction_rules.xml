<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nuvem e troca de aparelho levam só o banco (a chave da API não: ela é cifrada no aparelho). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
